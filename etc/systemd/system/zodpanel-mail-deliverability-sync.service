[Unit]
Description=ZodPanel mail deliverability DNS, DKIM, SPF, DMARC, and TLS sync
After=network-online.target hestia.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/hestia/bin/zodpanel-mail-deliverability-sync
TimeoutStartSec=8min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
