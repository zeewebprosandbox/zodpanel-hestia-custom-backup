[Unit]
Description=ZodPanel burst mail deliverability sync after Hestia data changes
After=network-online.target hestia.service
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/usr/local/hestia/bin/zodpanel-mail-deliverability-sync --runs 1
TimeoutStartSec=8min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
