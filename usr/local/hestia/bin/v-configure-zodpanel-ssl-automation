#!/bin/bash
# info: Configure ZodPanel real-time SSL automation
# options: [INTERVAL_SECONDS]
#
# example: v-configure-zodpanel-ssl-automation 30
#
# This function installs systemd units that keep web, alias, subdomain,
# mail, and webmail SSL synced shortly after Hestia data changes.

interval=${1:-30}

source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_hestia_demo_mode

if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 15 ]; then
	echo "Error: interval must be an integer >= 15 seconds"
	exit "$E_INVALID"
fi

cat > /etc/systemd/system/zodpanel-ssl-sync.service <<EOL
[Unit]
Description=ZodPanel SSL, DNS, mail, and webmail sync
After=network-online.target hestia.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/hestia/bin/zodpanel-ssl-sync
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
EOL

cat > /etc/systemd/system/zodpanel-ssl-sync-burst.service <<EOL
[Unit]
Description=ZodPanel burst SSL sync after Hestia data changes
After=network-online.target hestia.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/hestia/bin/zodpanel-ssl-sync --runs 6 --interval 10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
EOL

path_entries=""
for conf in /usr/local/hestia/data/users/*/web.conf /usr/local/hestia/data/users/*/mail.conf /usr/local/hestia/data/users/*/dns.conf; do
	if [ -f "$conf" ]; then
		path_entries="${path_entries}PathChanged=$conf
PathModified=$conf
"
	fi
done

cat > /etc/systemd/system/zodpanel-ssl-sync.path <<EOL
[Unit]
Description=Watch Hestia domain data for ZodPanel SSL sync

[Path]
PathChanged=/usr/local/hestia/data/users
PathModified=/usr/local/hestia/data/users
$path_entries
Unit=zodpanel-ssl-sync-burst.service

[Install]
WantedBy=multi-user.target
EOL

cat > /etc/systemd/system/zodpanel-ssl-sync.timer <<EOL
[Unit]
Description=Run ZodPanel SSL sync frequently

[Timer]
OnBootSec=20s
OnUnitActiveSec=${interval}s
AccuracySec=5s
Unit=zodpanel-ssl-sync.service

[Install]
WantedBy=timers.target
EOL

systemctl daemon-reload
systemctl enable --now zodpanel-ssl-sync.timer zodpanel-ssl-sync.path
systemctl start zodpanel-ssl-sync.service

check_result $? "ZodPanel SSL automation setup failed" > /dev/null

log_event "$OK" "$ARGUMENTS"
exit
