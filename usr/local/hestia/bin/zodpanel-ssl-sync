#!/usr/bin/env bash
# zodpanel-ssl-sync — ZodPanel Continuous Real-Time Auto-SSL Engine
# Triggers instant 0-second SAN SSL, Force HTTPS, Hostname SSL (port 8083), and background Let's Encrypt resolution.

USER="${1:-}"
DOMAIN="${2:-}"

SCRIPT_PATH="/usr/local/hestia/bin/v-configure-zodpanel-ssl-automation"
if [ ! -f "$SCRIPT_PATH" ]; then
    SCRIPT_PATH="/tmp/v-configure-zodpanel-ssl-automation"
fi

if [ -f "$SCRIPT_PATH" ]; then
    bash "$SCRIPT_PATH" "$USER" "$DOMAIN"
else
    # Fallback to direct Let's Encrypt host check if script is missing
    if [ -x /usr/local/hestia/bin/v-add-letsencrypt-host ]; then
        /usr/local/hestia/bin/v-add-letsencrypt-host >/dev/null 2>&1 || true
    fi
fi
