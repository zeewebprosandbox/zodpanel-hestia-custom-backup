#!/bin/bash
# info: Adding force SSL for mail/webmail domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: v-add-mail-domain-ssl-force admin acme.com
#
# This function forces HTTPS for mail.domain and the configured webmail alias.

user=$1
domain=$2
restart="$3"
quiet="$4"

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

check_hestia_demo_mode

parse_object_kv_list $(grep "DOMAIN='$domain'" $USER_DATA/mail.conf)

if [ "$SSL" != 'yes' ]; then
	echo "Error: Mail SSL is not enabled"
	exit "$E_NOTEXIST"
fi

if [ -n "$PROXY_SYSTEM" ]; then
	forcessl="$HOMEDIR/$user/conf/mail/$domain/$PROXY_SYSTEM.forcessl.conf"
else
	forcessl="$HOMEDIR/$user/conf/mail/$domain/$WEB_SYSTEM.forcessl.conf"
fi

if [ -n "$PROXY_SYSTEM" ] || [ "$WEB_SYSTEM" = 'nginx' ]; then
	echo 'return 301 https://$host$request_uri;' > $forcessl
else
	echo 'RewriteEngine On' > $forcessl
	echo 'RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]' >> $forcessl
fi

chown root:$user $forcessl
chmod 640 $forcessl

$BIN/v-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/v-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

if [ "$quiet" != "yes" ]; then
	$BIN/v-log-action "$user" "Info" "Mail" "Automatic HTTPS redirection enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit
